{
  "name": "purge-game-server",
  "version": "1.0.0",
  "description": "WebSocket server for Purge Game multiplayer",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/game-server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "watch": "tsc -w",
    "clean": "rm -rf dist",
    "start:dev": "ts-node-dev --respawn --transpile-only src/game-server.ts"
  },
  "keywords": [
    "websocket",
    "game",
    "multiplayer",
    "solana"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.24",
    "@types/ws": "^8.5.6",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}